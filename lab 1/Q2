A = [[1, 2], [3, 4]]
B = [[5, 6], [7, 8]]

if len(A[0]) != len(B):
    print("Error! Matrices cannot be multiplied.")
else:
    result = [[0, 0], [0, 0]]

    for i in range(2):
        for j in range(2):
            for k in range(2):
                result[i][j] += A[i][k] * B[k][j]

    print(result)